# ==========================================
# BACKEND SECRETS (Configure on Render)
# ==========================================
# Google Gemini API Key (Backend ONLY - NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (Default: 3001)
PORT=3001

# ==========================================
# FRONTEND CONFIGURATION (Configure on Vercel)
# ==========================================
# Backend API Base URL for Production (Leave empty for local dev to use Vite proxy)
# Example for Vercel: VITE_API_URL=https://the-panel-backend.onrender.com
VITE_API_URL=
